# Copy to .env and fill in real values. NEVER commit .env.

# --- PostgreSQL container (read by docker compose) ---
POSTGRES_USER=channel_factory
POSTGRES_PASSWORD=
POSTGRES_DB=channel_factory
POSTGRES_PORT=5432

# --- Application database access ---
# Must match the POSTGRES_* values above.
DATABASE_URL=postgresql+asyncpg://channel_factory:<password>@localhost:5432/channel_factory
# Optional: database used by integration tests. Defaults to DATABASE_URL + "_test".
TEST_DATABASE_URL=

# --- Runtime ---
LOG_LEVEL=INFO
DB_ECHO=false

# --- Research engine ---
# Free tier, no credit card: https://aistudio.google.com — preferred automatically
# when set, because it costs nothing. Note that on the free tier Google may use
# prompts and responses to improve their products; we send only public article
# titles and summaries.
GEMINI_API_KEY=
GEMINI_DAILY_REQUEST_LIMIT=1000
# Observed: the free tier throttles sooner than its documented per-minute rate,
# so this is set conservatively. Raise it only if 429s stay rare.
GEMINI_REQUESTS_PER_MINUTE=5
# Paid alternative. Used only when no Gemini key is present.
ANTHROPIC_API_KEY=
DAILY_COST_LIMIT_USD=2.00
MONTHLY_COST_LIMIT_USD=30.00
# Optional but recommended: raises the GitHub API quota for release polling.
GITHUB_TOKEN=

# --- MAX publishing (free Bot API, https://dev.max.ru/docs-api) ---
# Bot token issued by @MasterBot in the MAX app. Never commit it.
MAX_BOT_TOKEN=
# Channel id to publish into. Find it with: cli max-discover
MAX_CHAT_ID=
# Optional overrides. The default host is platform-api.max.ru: the documented
# platform-api2.max.ru serves a Russian Trusted Root CA certificate that is in
# neither certifi nor the Windows store. To use it, set both lines below.
# MAX_API_BASE_URL=https://platform-api2.max.ru
# MAX_CA_BUNDLE=C:/certs/russian-trusted-root.pem
ussian-trusted-root.pem
# MAX_REQUEST_TIMEOUT=30

# --- Publishing safety switches ---
# Both default to "off": an autonomous publisher must be harmless until
# someone deliberately turns it on. Real posts need LIVE *and* true.
PUBLISH_MODE=DRY_RUN
AUTO_PUBLISH_ENABLED=false

# --- Posting schedule ---
# Local times of the daily slots, and how long a slot stays fillable after it
# opens (so a missed run catches up instead of skipping a post).
PUBLISH_SLOTS=09:00,14:00,19:00
# Часовой пояс канала, а не сервера: на runner'е GitHub время UTC,
# и без этой строки 09:00 превращается для читателя в полдень.
PUBLISH_TIMEZONE=Europe/Moscow
PUBLISH_SLOT_WINDOW_MINUTES=180
# Which slots carry our own posts instead of news (0-based indexes).
PUBLISH_OWN_SLOTS=1
# A topic older than this is history, not news.
PUBLISH_MAX_TOPIC_AGE_HOURS=48

# --- Breaking news: publishes outside the schedule, so the bar is high ---
BREAKING_ENABLED=true
BREAKING_MIN_SCORE=90
BREAKING_MAX_AGE_MINUTES=240
# Confirmation: two sources, or the vendor's own announcement.
BREAKING_MIN_SOURCES=2
BREAKING_MAX_PER_DAY=2
BREAKING_MIN_GAP_MINUTES=90

# --- Content generation ---
# Order: Ollama (if it answers) -> OpenAI-compatible endpoint -> Gemini.
# A local model is preferred: free, no quota, nothing leaves the machine.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Any OpenAI-compatible endpoint. Free options that need no card:
#   Qwen via Alibaba Model Studio (~1M tokens per model, 90 days, Singapore):
#     CONTENT_API_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#     CONTENT_MODEL=qwen-plus
#   OpenRouter ":free" models (20 req/min, 50 req/day at zero balance):
#     CONTENT_API_BASE_URL=https://openrouter.ai/api/v1
#     CONTENT_MODEL=z-ai/glm-5.2:free
CONTENT_API_BASE_URL=
CONTENT_API_KEY=
CONTENT_MODEL=

# --- Future phases (listed so the shape is known) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHANNEL_ID=
# OPENAI_API_KEY=
